# IIITA Arrive configuration. Copy to .env.local and fill in what you need.

# Password for the seeded staff accounts (admin@, verify@, desk@, warden@, senior@iiita.ac.in).
# Read once when the database is first created. Change it before anyone else can reach the server.
ARRIVE_STAFF_PASSWORD=arrive-2026

# Where the SQLite database and uploaded files live. Defaults to ./.data
# ARRIVE_DATA_DIR=/var/lib/arrive

# SMS provider for sign-in codes. Receives POST {"to": "+91XXXXXXXXXX", "text": "..."}.
# Without it, codes are shown on screen in development and sign-in is refused in production.
# SMS_WEBHOOK_URL=https://your-sms-relay.example/send
# SMS_WEBHOOK_TOKEN=

# Force on-screen codes in production (demos and usability tests only).
# ARRIVE_DEV_OTP=1

# DigiLocker partner credentials. Without them a sandbox issuer is used and labelled as such.
# DIGILOCKER_CLIENT_ID=

# Allow session cookies over plain http in production (local testing of `npm start` only).
# ARRIVE_INSECURE_COOKIES=1
